# ==============================================
# Application Environment Configuration
# ==============================================

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=ECommerceBackendAPI

# Database
# If left as 'memory', an in-memory MongoDB will be automatically spun up for local dev.
# For production or MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/ecommerce?retryWrites=true&w=majority
MONGODB_URI=memory

# JWT Configuration
JWT_ACCESS_SECRET=super_secret_jwt_access_key_change_in_production_32bytes_min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_32bytes_min
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Payment Configuration
# Options: 'mock' (default for local dev/testing) or 'stripe'
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
PAYMENT_CURRENCY=usd

# Admin Initial Seed Credentials
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword123!
